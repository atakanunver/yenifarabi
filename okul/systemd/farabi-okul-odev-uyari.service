# Teslimi yaklaşan ödev uyarısı — kurulum:
#   sudo cp okul/systemd/farabi-okul-odev-uyari.{service,timer} /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now farabi-okul-odev-uyari.timer
[Unit]
Description=Dijital Okul: teslimi yaklaşan ödev push uyarısı
After=farabi-okul.service

[Service]
Type=oneshot
User=ata
WorkingDirectory=/home/ata/farabi/okul
ExecStart=/home/ata/farabi/okul/venv/bin/python scripts/odev_uyari.py
Nice=10
