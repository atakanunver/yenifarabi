# Haftalık ödül kapanışı — kurulum:
#   sudo cp okul/systemd/farabi-okul-odul-kapat.{service,timer} /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now farabi-okul-odul-kapat.timer
[Unit]
Description=Dijital Okul: biten haftanın ödüllerini yaz
After=farabi-okul.service

[Service]
Type=oneshot
User=ata
WorkingDirectory=/home/ata/farabi/okul
ExecStart=/home/ata/farabi/okul/venv/bin/python scripts/odul_kapat.py
Nice=10
