[Unit]
Description=Farabi idari belge taraması — mudur/ klasöründeki yeni/değişen belgeleri RAG'a yükler (bge-m3, bilgehan)
After=postgresql.service network-online.target

[Service]
Type=oneshot
User=ata
WorkingDirectory=/home/ata/farabi/server
ExecStart=/home/ata/farabi/server/venv/bin/python idari_yukle.py
Nice=15
CPUSchedulingPolicy=batch
CPUWeight=20
IOWeight=20
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=3h

