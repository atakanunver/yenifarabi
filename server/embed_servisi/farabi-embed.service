[Unit]
Description=Farabi RAG gomme + rerank servisi (bge-m3 / bge-reranker-v2-m3, GTX 1660 Ti)
After=network-online.target nvidia-persistenced.service
Wants=network-online.target

[Service]
User=ata
Group=ata
WorkingDirectory=/opt/farabi-embed
# PCI sirasi: 0 = 01:00.0 GTX 1660 Ti, 1 = 02:00.0 RTX 3060 (bos, rezerve).
Environment="CUDA_DEVICE_ORDER=PCI_BUS_ID"
Environment="CUDA_VISIBLE_DEVICES=0"
Environment="HF_HOME=/opt/farabi-embed/hf"
Environment="HF_HUB_OFFLINE=1"
Environment="TRANSFORMERS_OFFLINE=1"
# FARABI_EMBED_ANAHTAR burada (repoya girmez, 600 izinli)
EnvironmentFile=/opt/farabi-embed/.env
ExecStart=/opt/farabi-embed/venv/bin/python -m uvicorn app:app --host 0.0.0.0 --port 8040 --workers 1
Restart=always
RestartSec=5
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
