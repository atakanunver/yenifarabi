# voice_node/config/ses_node.env.example — şablon, GERÇEK değerler
# ses_node.env'de (gitignore'lu, mod 600). Sırlar burada BOŞ bırakılır.

# Sırlar — gerçek değerler ses_node.env'de, buraya YAZILMAZ.
FARABI_SES_TOKEN=
TEST_TAHTA_ANAHTARI=

# Brain (server/ses_cephe.py) ve Piper HTTP servisinin adresleri.
BRAIN_URL=http://127.0.0.1:8000
PIPER_URL=http://127.0.0.1:5050

# Whisper modeli — /mnt/farabi-data/farabi/ses/ altında (DATA_DIR deseni).
WHISPER_MODEL_DIR=/mnt/farabi-data/farabi/ses/whisper/large-v3-turbo
WHISPER_DEVICE=cuda
WHISPER_COMPUTE=int8_float16

# Ses düğümü websocket portu (LAN, 0.0.0.0).
SES_PORT=8030

# İzinli ağlar (virgüllü CIDR) — bunların dışından gelen WS bağlantısı reddedilir.
IZINLI_AGLAR=192.168.23.0/24,127.0.0.1/32,::1/128

# Pilotta kapalı — A/B ölçümü sonraki adım (plan).
RNNOISE=0

NLTK_DATA=/mnt/farabi-data/farabi/ses/nltk_data
CUDA_VISIBLE_DEVICES=0
CUDA_DEVICE_ORDER=PCI_BUS_ID
LOGURU_LEVEL=INFO
