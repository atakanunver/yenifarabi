# voice_node/systemd/farabi-piper.service — METİN, kurulum kullanıcı adımı.
# Bkz. farabi-ses.service üstündeki not — bu fazda enable/start EDİLMEZ.
#
#   sudo cp voice_node/systemd/farabi-piper.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now farabi-piper.service
#
# ⚠️ --host 127.0.0.1 ŞART — piper.http_server varsayılanı 0.0.0.0'dır ve
# `POST /download` gibi uçlar var; LAN'a açılırsa herhangi bir cihaz model
# indirtebilir/CPU'yu meşgul edebilir.

[Unit]
Description=Farabi Piper TTS HTTP servisi (yalnızca localhost)
After=network.target

[Service]
Type=simple
User=ata
WorkingDirectory=/home/ata/farabi/voice_node/piper_servis
Environment=OMP_NUM_THREADS=4
ExecStart=/home/ata/farabi/voice_node/piper_servis/venv/bin/python -m piper.http_server \
    -m tr_TR-dfki-medium \
    --data-dir /mnt/farabi-data/farabi/ses/piper \
    --host 127.0.0.1 --port 5050
Nice=5
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
