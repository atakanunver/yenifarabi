[Unit]
Description=Farabi haftalık birincilerin kartını üret (veri/gorseller/; tahtaya göndermez)
After=network-online.target farabi-okul.service

[Service]
Type=oneshot
User=ata
WorkingDirectory=/home/ata/farabi/tahtayoklama/dashboard
ExecStart=/home/ata/farabi/tahtayoklama/dashboard/venv/bin/python scripts/hafta_karti_uret.py
TimeoutStartSec=300
Nice=10
