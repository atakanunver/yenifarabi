[Unit]
Description=Sinif Arenasi Akilli Tahta Yarismasi Servisi
After=network.target farabi-api.service ollama.service

[Service]
Type=simple
User=ata
WorkingDirectory=/home/ata/arenasinif
ExecStart=/home/ata/arenasinif/venv/bin/uvicorn server:app --host 0.0.0.0 --port 8030
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
