[Unit]
Description=Soru havuzu gece üretimi (yerel Ollama qwen3.8:27b) — ders saatinde kendiliğinden durur; AGY denetimi yok (kota), denetim bulut LLM ile sonra
After=ollama.service postgresql.service network-online.target

[Service]
Type=simple
User=ata
WorkingDirectory=/home/ata/farabi
ExecStart=/home/ata/farabi/server/venv/bin/python -m soruhavuzu.calistir uret --denetimsiz
Nice=15
CPUSchedulingPolicy=batch
CPUWeight=20
IOWeight=20
IOSchedulingClass=best-effort
IOSchedulingPriority=7
